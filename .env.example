# Copy to .env.local (gitignored) to run the UI quality loop:
#   npm run ui:shots && npm run ui:judge
# See docs/ui-qa-loop.md.

# ── UI QA judge — vision LLM ───────────────────────────────────────────────
# The screenshot judge (scripts/ui-judge.mjs) sends captured page shots to a
# VISION-capable, OpenAI-compatible chat-completions endpoint and scores them
# against docs/ui-rubric.md. Any vision model works (swap base/key/model).
#
# DeepSeek: `deepseek-v4-flash-vision-exp` is the ONLY model id that accepts
# images — deepseek-v4-flash / deepseek-v4-pro return HTTP 400 for image input.
LLM_VISION_API_KEY=your-vision-api-key
LLM_VISION_BASE_URL=https://api.deepseek.com/v1
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp

# Optional: point the capture at non-default ports.
# UI_CUSTOMER_URL=http://localhost:5173
# UI_ADMIN_URL=http://localhost:5174
# Optional: system Chrome location.
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
