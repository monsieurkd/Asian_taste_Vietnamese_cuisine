# Local shell secrets for the Asian Taste production stack.
#
# ─────────────────────────────────────────────────────────────────────────────
# Copy this to .secrets.local and fill it in:
#
#     cp .secrets.local.example .secrets.local
#     $EDITOR .secrets.local
#     source .secrets.local
#
# .secrets.local is GITIGNORED. That file is the right place for a live
# credential, and this template is the right place for the instructions —
# never the other way round.
#
# Do NOT put real values in THIS file: it is committed, so anything here is in
# git history permanently.
# ─────────────────────────────────────────────────────────────────────────────

# --- Neon (PostgreSQL) ------------------------------------------------------
#
# Find it in the Neon console → your project → Connection string.
#
# IMPORTANT: Neon shows you the `postgresql://user:pass@host/db` URI form.
# Npgsql does NOT accept that, and the API fails at startup with
# "Couldn't set postgresql://..." if you paste it in directly. Convert it:
#
#   postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/neondb?sslmode=require
#
# becomes:
#
#   Host=ep-xxx-pooler.ap-southeast-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=PASSWORD;SSL Mode=Require;Trust Server Certificate=true;Pooling=true;Maximum Pool Size=10
#
# Use the -pooler host (serverless Postgres bills per connection and the API
# opens one per request), and keep the password exactly as Neon issued it —
# it is case-sensitive.
export NEON_CONNECTION_STRING=""

# --- Fly.io -----------------------------------------------------------------
#
# Create with:
#   fly tokens create org personal --name "github-actions-deploy" --expiry 8760h
#
# For CI, put the value in a GitHub secret instead of here:
#   gh secret set FLY_API_TOKEN --repo <owner>/<repo>
export FLY_API_TOKEN=""

# --- Vercel -----------------------------------------------------------------
#
# Mint from PERSONAL Account Settings → Tokens, NOT Team Settings.
#
# This distinction is the whole reason the CI Vercel job was failing: a token
# created under Team Settings is team-scoped and carries no user identity, so
# `vercel whoami` answers "User not found" and every CLI command fails with
# "Could not retrieve Project Settings". The REST API accepts such a token,
# which is what made it confusing — only the CLI rejects it.
export VERCEL_TOKEN=""

# --- Application secrets ----------------------------------------------------
#
# Generate fresh ones rather than reusing anything:
#   openssl rand -base64 32   # -> ENCRYPTION_KEY
#   openssl rand -base64 48   # -> JWT_SECRET_KEY
#
# Rotating ENCRYPTION_KEY invalidates stored Lightspeed tokens (re-authorise
# after). Rotating JWT_SECRET_KEY logs every admin out.
export ENCRYPTION_KEY=""
export JWT_SECRET_KEY=""

# --- Applying them ----------------------------------------------------------
#
# Fly (this is what actually sets production):
#   fly secrets set \
#     "ConnectionStrings__DefaultConnection=$NEON_CONNECTION_STRING" \
#     "Encryption__Key=$ENCRYPTION_KEY" \
#     "Jwt__SecretKey=$JWT_SECRET_KEY"
#
# GitHub Actions secrets:
#   gh secret set FLY_API_TOKEN     --repo <owner>/<repo>
#   gh secret set VERCEL_TOKEN      --repo <owner>/<repo>
#   gh secret set VERCEL_ORG_ID     --repo <owner>/<repo>
#   gh secret set VERCEL_CUSTOMER_PROJECT_ID --repo <owner>/<repo>
#
# Vercel project env vars (frontend):
#   set in the Vercel dashboard, or via the API — see docs/DEPLOYMENT.md
