# Stripe Configuration
# Get your keys from: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# API Configuration
#
# VITE_API_BASE_URL — note this app uses VITE_API_BASE_URL, NOT VITE_API_URL.
# VITE_API_URL is the ADMIN app's variable name. Setting only that on this
# project makes every request go to this app's own /api path (404) and the menu
# renders "No items found" with no error — which is a real outage this repo has
# now had once.
#
# Must INCLUDE the /api segment. Deployed value:
#   https://asian-taste-api.fly.dev/api
VITE_API_BASE_URL=http://localhost:5070/api
