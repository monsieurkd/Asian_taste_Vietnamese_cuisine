# Stripe Keys
# This is the PUBLISHABLE key (safe to expose in frontend code).
# Get yours from: https://dashboard.stripe.com/test/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# API Base URL
# Must INCLUDE the /api path segment. Leaving it as just the origin (e.g.
# http://localhost:5070) makes every request hit /menu/... instead of
# /api/menu/... and return 404 — see docs/GUARDRAILS.md.
# Leave unset in development to use the Vite proxy and avoid this entirely.
VITE_API_BASE_URL=http://localhost:5070/api
