# API base URL for the admin dashboard.
# Leave unset (or set to /api) to use the Vite dev proxy configured in vite.config.ts.
# For a deployed API, use the full origin, e.g. https://api.asiantaste.com.au/api
VITE_API_URL=/api

# WebSocket base URL for real-time order updates.
# Leave unset to derive it from the current page origin (recommended for deployed sites).
# For local dev against the API directly, set: ws://localhost:5070
VITE_WS_URL=
