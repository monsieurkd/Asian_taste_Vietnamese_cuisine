# macOS
.DS_Store

# .NET build output
bin/
obj/
*.user
*.suo

# Node / frontend build output (frontends also carry their own .gitignore)
node_modules/
dist/
.next/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs
*.log

# Local UI screenshots / tooling config (not for the repo)
reasonix.toml

# Reasonix runtime state (tasks, logs, telemetry) — local only.
.reasonix/*
# ...but the custom skills/agents ARE shared with the team.
!.reasonix/skills/
!.reasonix/skills/**

# Local secrets / environment-specific config (use .example templates + user-secrets)
src/AsianTaste.API/appsettings.Development.json
src/AsianTaste.API/appsettings.Local.json
src/asian-taste-customer/.env.development
src/asian-taste-admin/.env.development
.env
.env.local
.env.*.local

# Real production values live in the host's own settings (Vercel env vars, Fly
# secrets), never in the repo. These are listed because the two .development
# entries above cover one filename each, so a real .env.production would
# otherwise be committed by the next `git add .`. The .example templates stay
# trackable (see the ! rules below, if any).
.env.production
.env.production.local
src/asian-taste-customer/.env.production
src/asian-taste-admin/.env.production
src/asian-taste-customer/.env.development.local
src/asian-taste-admin/.env.development.local

# Vercel CLI link metadata. Created by `vercel link` / `vercel pull`, and it
# carries the project and org IDs plus the pulled env values — so it must never
# be committed. CI recreates it per run.
.vercel
src/asian-taste-customer/.vercel
src/asian-taste-admin/.vercel
.vercelignore

# UI quality loop output (screenshots + judge report are artifacts, not source)
ui-shots/
.neon

# Local shell secrets (see .secrets.local.example). The real file holds live
# credentials and must never be committed.
.secrets.local

# Test artifacts (dotnet test produces TestResults/*.trx on every run).
TestResults/
*.trx

# Swarm run state: logs, briefs, plans, reports. Local only — it is an audit trail
# for the machine that ran it, not source. The agent roles under .reasonix/skills/
# ARE tracked (see the ! rules above); this is only what a run produces.
.swarm/
